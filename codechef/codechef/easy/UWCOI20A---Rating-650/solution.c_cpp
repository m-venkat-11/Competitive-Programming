#include <stdio.h>

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        int n;
        scanf("%d", &n);
        int max_val = 0;
        for (int i = 0; i < n; i++) {
            int h;
            scanf("%d", &h);
            if (h > max_val) {
                max_val = h;
            }
        }
        printf("%d\n", max_val);
    }
    return 0;
}